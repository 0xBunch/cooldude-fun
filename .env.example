# ── COOL DUDE'S ARCADE — environment ──────────────────────────────────────────
# Copy to ".env" for local dev. In production these are set in Railway.

# Port (Railway provides this automatically in prod).
PORT=8787

# Public origins. Locally you can leave these as-is; the app derives the games
# host from the same server so a separate subdomain isn't required for dev.
PUBLIC_BASE_URL=http://localhost:8787
GAMES_BASE_URL=http://localhost:8787

# ── Soft gate ────────────────────────────────────────────────────────────────
# The shared "arcade code" James gives his friends. Anything you like.
ARCADE_CODE=letmein
# Secret used to sign the gate cookie (any long random string).
COOKIE_SECRET=dev-only-change-me-to-something-long-and-random
# Owner moderation token for DELETE /api/scores/:id (send as x-admin-token header).
ADMIN_TOKEN=dev-admin-token-change-me

# ── Database ─────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when you add the Postgres plugin.
# For local dev, point at a local Postgres, OR leave blank to run with an
# in-memory leaderboard (great for trying the UI without a database).
DATABASE_URL=

# ── Google Drive (the games folder) ──────────────────────────────────────────
# The Drive folder ID that holds the game .html files.
DRIVE_FOLDER_ID=
# The service-account JSON key, base64-encoded (single line):
#   base64 -i service-account.json | tr -d '\n'
# Leave BOTH blank for local dev — the app falls back to a local "games-local/"
# folder so you can build games and test the whole flow offline.
GOOGLE_SERVICE_ACCOUNT_JSON=
